# Render sets PORT automatically. Leave it at 5000 for local development.
PORT=5000
NODE_ENV=development

# Exact URL(s) of the deployed Vercel frontend, comma-separated when needed.
FRONTEND_URL=http://localhost:5173

# Public address of this Render service. It is safe to expose.
PUBLIC_API_URL=https://shirishtisnetflix.onrender.com

# Use one Cloudinary URL in Render (recommended). The cloud name is prefilled;
# never commit real credentials to this file.
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@orucjbzl
